{
    "$schema": "https://json.schemastore.org/swcrc",
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "decorators": true
        },
        "transform": {
            "decoratorMetadata": true,
            "legacyDecorator": true
        },
        "target": "es2023",
        "keepClassNames": true
    },
    "module": {
        "type": "commonjs"
    }
}