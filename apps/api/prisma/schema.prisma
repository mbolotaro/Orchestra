generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid(7)) @db.Uuid
  firstName String @db.VarChar(100) @map("first_name")
  lastName String @db.VarChar(100) @map("last_name")
  email String @db.VarChar(254)
  isEmailVerified Boolean @map("is_email_verified") @default(false)
  passwordHash String? @db.VarChar(255) @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  oAuthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@unique([email], where: { deletedAt: null })
  @@map("users")
  passwordResetTokens PasswordResetToken[]
}

enum OAuthAccountType {
  Google @map("google")
  GitHub @map("github")

  @@map("oauth_account_type")
}

model OAuthAccount {
  id String @id @default(uuid(7)) @db.Uuid
  provider OAuthAccountType
  providerId String @db.VarChar(255) @map("provider_id")
  userId String @db.Uuid @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

enum AuthAction {
  SignUp @map("sign_up")
  SignIn @map("sign_in")
  SignOut @map("sign_out")
  Refresh @map("refresh")
  VerifyEmail @map("verify_email")
  ResendVerifyEmail @map("resend_verify_email")
  ForgotPassword @map("forgot_password")
  PasswordReset @map("password_reset")

  @@map("auth_action")
}

enum AuthStatus {
  Success @map("success")
  Failed @map("failed")
  UserNotFound @map("user_not_found")
  WrongPassword @map("wrong_password")
  NoPasswordHash @map("no_password_hash")
  Reuse @map("reuse")
  InvalidVerifyToken @map("invalid_verify_token")
  InvalidResetPasswordToken @map("invalid_reset_password_token")
  @@map("auth_status")
}

model AuthLog {
  id String @id @default(uuid(7)) @db.Uuid
  userId String? @db.Uuid @map("user_id")
  email String? @db.VarChar(254)
  action AuthAction
  provider OAuthAccountType?
  status AuthStatus
  userAgent String? @db.VarChar(512) @map("user_agent")
  ipAddress String? @db.VarChar(45) @map("ip_address")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([email, occurredAt])
  @@index([userId, occurredAt])

  @@map("auth_logs")
}

model RefreshToken {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  jti String @unique @db.VarChar(36)
  tokenHash String @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String? @db.VarChar(36)
  createdAt DateTime @default(now())
  userAgent String? @db.VarChar(512)
  ipAddress String? @db.VarChar(45)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([jti])

  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  email     String    @db.VarChar(254)
  tokenHash String    @unique @db.VarChar(64) @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid @map("user_id")
  email String @db.VarChar(254)
  tokenHash String @unique @db.VarChar(64) @map("token_hash")
  usedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}