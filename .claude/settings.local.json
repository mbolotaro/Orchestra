{
  "permissions": {
    "allow": [
      "Bash(pnpm exec *)",
      "Bash(pnpm --filter @orchestra/api exec nest build)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(curl -s http://localhost:3000/)",
      "Bash(curl -s -X POST http://localhost:3000/users -H \"Content-Type: application/json\" -d '{\"name\":\"Mario\",\"email\":\"m@m.com\",\"password\":\"secret123\"}')",
      "Bash(curl -s -X POST http://localhost:3000/users -H \"Content-Type: application/json\" -d '{\"name\":\"M\",\"email\":\"not-an-email\",\"password\":\"x\"}')",
      "Bash(curl -s -I http://localhost:3000/docs)"
    ]
  }
}
